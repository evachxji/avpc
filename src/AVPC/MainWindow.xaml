<Window
    x:Class="AVPC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#661C1E24" />
        <SolidColorBrush x:Key="BorderBrush" Color="#18FFFFFF" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="25" Height="25" Source="/Assets/AVPC.png" />
                <TextBlock Text="AVPC 播放控台" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="播放控制台" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#226F9FF4" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="●  预览模式" Foreground="#FFACCAFF" FontSize="12" />
                </Border>
            </StackPanel>
            <ComboBox x:Name="ConsoleDisplaySelector" Grid.Column="1" MinWidth="195" SelectionChanged="ConsoleDisplayChanged" />
            <ComboBox x:Name="OutputDisplaySelector" Grid.Column="2" MinWidth="195" SelectionChanged="OutputDisplayChanged" />
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" MinWidth="390" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="素材库" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="＋ 导入素材" HorizontalAlignment="Right" Click="ImportClicked" />
                    </Grid>
                    <AutoSuggestBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="搜索素材" QueryIcon="Find" TextChanged="SearchChanged" />
                    <ListView x:Name="MediaList" Grid.Row="2" SelectionMode="Single" CanDragItems="True" DragItemsStarting="MediaDragStarting">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="62" Height="42" CornerRadius="5" Background="#FF292D36" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Asset.DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Asset.Path}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                            <Border Background="#226F9FF4" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding KindName}" FontSize="9" Foreground="#FFACCAFF" />
                                            </Border>
                                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="方案预览" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="PreviewSchemeText" Text="尚未选择方案" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </Grid>
                        <Border Height="310" CornerRadius="8" Background="Black">
                            <Grid>
                                <MediaPlayerElement x:Name="PreviewView" Stretch="Uniform" AreTransportControlsEnabled="False" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                                <Grid x:Name="PreviewFadeOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Padding="8,4" CornerRadius="4" Background="#99000000">
                                    <TextBlock Text="实际输出效果预览" FontSize="10" Foreground="#FFBCD0EF" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <Button Content="▶ 预览" Click="PreviewClicked" />
                            <Button Grid.Column="1" Content="■ 停止" Click="StopPreviewClicked" />
                            <Slider x:Name="PreviewProgress" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1000" />
                            <Slider x:Name="PreviewVolume" Grid.Column="3" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" StepFrequency="0.05" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="选中方案设置" FontSize="14" FontWeight="SemiBold" />
                                <TextBox x:Name="SchemeNameBox" Header="方案名称" TextChanged="SchemeNameChanged" />
                                <ComboBox x:Name="VisualKindSelector" Header="画面来源" SelectionChanged="VisualKindChanged">
                                    <ComboBoxItem Content="视频" />
                                    <ComboBoxItem Content="图片组" />
                                </ComboBox>
                                <ComboBox x:Name="VideoSelector" Header="视频" SelectionChanged="VideoChanged" />
                                <StackPanel><TextBlock Text="图片（可多选，按选择顺序轮播）" Margin="0,0,0,6" /><ListView x:Name="ImageSelector" SelectionMode="Multiple" SelectionChanged="ImagesChanged" Height="108">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Asset.DisplayName}" ToolTipService.ToolTip="{Binding Asset.Path}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView></StackPanel>
                                <NumberBox x:Name="ImageDurationBox" Header="每张图片停留（秒）" Minimum="1" Maximum="3600" SmallChange="1" SpinButtonPlacementMode="Inline" ValueChanged="ImageDurationChanged" />
                                                                <StackPanel>
                                    <TextBlock Text="独立音频（可多选，按选择顺序播放；不选则使用视频原声）" Margin="0,0,0,6" />
                                    <ListView x:Name="AudioSelector" SelectionMode="Multiple" SelectionChanged="AudioChanged" Height="92">
                                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Asset.DisplayName}" ToolTipService.ToolTip="{Binding Asset.Path}" /></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="VideoLoopCheck" Content="视频循环" Checked="VideoLoopChanged" Unchecked="VideoLoopChanged" />
                                    <CheckBox x:Name="AudioLoopCheck" Grid.Column="1" Content="音频循环" Checked="AudioLoopChanged" Unchecked="AudioLoopChanged" />
                                </Grid>
                                <ComboBox x:Name="EndBehaviorSelector" Header="非循环视频结束行为" SelectionChanged="EndBehaviorChanged">
                                    <ComboBoxItem Content="最后一帧" Tag="HoldLastFrame" />
                                    <ComboBoxItem Content="最后 2 秒淡出" Tag="FadeToBlack" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SchemeCountText" Text="播放方案 · 0 套" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="拖拽 ⋮⋮ 排序" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="SchemeList" Grid.Row="1" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True" SelectionChanged="SchemeSelectionChanged" DragItemsCompleted="SchemesReordered" DragOver="SchemeDragOver" Drop="SchemeDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="#08FFFFFF" Margin="0,0,0,8" AllowDrop="True" DragOver="SchemeDragOver" Drop="SchemeDrop">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="88" Height="88" CornerRadius="7" Background="#FF101318" VerticalAlignment="Top">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="⋮⋮" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                                            <TextBlock Text="{Binding VisualName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#66000000" CornerRadius="5" Padding="8,4" Margin="0,2,0,0">
                                                <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding AudioRows}">
                                                        <ItemsControl.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Prefix}" Foreground="#FF71809A" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <CheckBox Content="视频循环" IsChecked="{Binding IsVideoLooping, Mode=TwoWay}" />
                                                <CheckBox Content="音频循环" IsChecked="{Binding IsAudioLooping, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Content="＋ 新建播放方案" HorizontalAlignment="Stretch" Click="AddSchemeClicked" />
                    <Button Grid.Row="3" Content="删除选中方案" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="DeleteSchemeClicked" />
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="3" Severity="Error" IsOpen="False" Margin="20,0,20,10" />

        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" />
                    <TextBlock Text="正式播放按方案顺序手动切换，最后一套之后停止" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="■ 停止输出" Click="StopOutputClicked" />
                <Button x:Name="PlayNextButton" Grid.Column="2" Content="▶ 开始正式播放" Style="{StaticResource AccentButtonStyle}" MinWidth="180" Click="PlayNextClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
