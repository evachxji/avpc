<Window
    x:Class="AVPC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AVPC">
    <Grid><Grid.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#661C1E24" />
        <SolidColorBrush x:Key="BorderBrush" Color="#18FFFFFF" />
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Width="25" Height="25" Source="/Assets/AVPC.png" />
                <TextBlock Text="AVPC 播放控台" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="播放控制台" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#226F9FF4" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="●  预览模式" Foreground="#FFACCAFF" FontSize="12" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="展示屏:" VerticalAlignment="Center" />
                <ComboBox x:Name="OutputDisplaySelector" MinWidth="195" SelectionChanged="OutputDisplayChanged" />
                <Button Width="36" Height="34" Padding="0" Click="RefreshDisplaysClicked" ToolTipService.ToolTip="刷新屏幕列表" AutomationProperties.Name="刷新屏幕列表">
                    <SymbolIcon Symbol="Refresh" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,14" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" MinWidth="390" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="素材库" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="＋ 导入素材" HorizontalAlignment="Right" Click="ImportClicked" />
                    </Grid>
                    <AutoSuggestBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="搜索素材" QueryIcon="Find" TextChanged="SearchChanged" />
                    <ListView x:Name="MediaList" Grid.Row="2" SelectionMode="Single" CanDragItems="True" DragItemsStarting="MediaDragStarting">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="62" Height="42" CornerRadius="5" Background="#FF292D36" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Asset.DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Asset.Path}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                            <Border Background="{Binding TagBackground}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding KindName}" FontSize="9" Foreground="{Binding TagForeground}" />
                                            </Border>
                                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel" Grid.Column="1" Background="#F215181D" SizeChanged="PreviewPanelSizeChanged" BorderBrush="#FF343B43" BorderThickness="1" CornerRadius="14" Padding="18">
                <Border.Resources>
                    <Style x:Key="MediaCardItemStyle" TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Border x:Name="CardRoot" Background="#FF1D2228" BorderBrush="#FF3A424A" BorderThickness="1" CornerRadius="9" Padding="7">
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF627B70" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                            <VisualStateGroup x:Name="SelectionStates">
                                                <VisualState x:Name="Unselected" />
                                                <VisualState x:Name="Selected">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF62B899" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1C3029" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="SelectedPointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="BorderBrush">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF62B899" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1C3029" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="MediaDeleteButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#CC000000" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="11" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#E6000000" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="Background">
                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF000000" />
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="VisualQueueItemTemplate">
                        <Grid Width="140">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="76" CornerRadius="6" Background="#FF242B30">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" ToolTipService.ToolTip="{Binding Asset.Path}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,2" CornerRadius="4" Background="#F2000000">
                                        <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Button Content="×" Margin="5" FontSize="14" Style="{StaticResource MediaDeleteButtonStyle}" ToolTipService.ToolTip="删除画面" Click="RemoveVisualClicked" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,7,2,0" FontSize="11" Foreground="#FFF0F2F3" TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Row="2" Margin="2,4,2,1">
                                <TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA5AD" />
                                <TextBlock Text="⠿" HorizontalAlignment="Right" FontSize="14" Foreground="#FF9AA5AD" ToolTipService.ToolTip="长按拖拽排序" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="VisualAppendItemTemplate">
                        <Border Width="140" Height="116" BorderBrush="#FF536D61" BorderThickness="1.5" CornerRadius="6" Background="#FF1B2421" AllowDrop="True" DragOver="VisualAppendDragOver" Drop="VisualAppendDrop">
                            <TextBlock Text="＋&#x0a;追加画面" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FF9AC4B2" />
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="AudioQueueItemTemplate">
                        <Grid Width="140">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="76" CornerRadius="6" Background="#FF203029">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Opacity="0.72" ToolTipService.ToolTip="{Binding Asset.Path}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,2" CornerRadius="4" Background="#F2000000">
                                        <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                    <Button Content="×" Margin="5" FontSize="14" Style="{StaticResource MediaDeleteButtonStyle}" ToolTipService.ToolTip="删除音频" Click="RemoveAudioItemClicked" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,7,2,0" FontSize="11" Foreground="#FFF0F2F3" TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Row="2" Margin="2,4,2,1">
                                <TextBlock Text="{Binding Duration}" FontFamily="Consolas" FontSize="10" Foreground="#FF9AA5AD" />
                                <TextBlock Text="⠿" HorizontalAlignment="Right" FontSize="14" Foreground="#FF9AA5AD" ToolTipService.ToolTip="长按拖拽排序" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="AudioAppendItemTemplate">
                        <Border Width="140" Height="116" BorderBrush="#FF536D61" BorderThickness="1.5" CornerRadius="6" Background="#FF1B2421" AllowDrop="True" DragOver="AudioAppendDragOver" Drop="AudioAppendDrop">
                            <TextBlock Text="＋&#x0a;追加音频" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FF9AC4B2" />
                        </Border>
                    </DataTemplate>
                    <local:QueueItemTemplateSelector x:Key="QueueItemTemplateSelector"
                        VisualItemTemplate="{StaticResource VisualQueueItemTemplate}"
                        VisualAppendTemplate="{StaticResource VisualAppendItemTemplate}"
                        AudioItemTemplate="{StaticResource AudioQueueItemTemplate}"
                        AudioAppendTemplate="{StaticResource AudioAppendItemTemplate}" />
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROGRAM PREVIEW" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Foreground="#FF62B899" />
                                <TextBlock Text="方案预览" FontSize="17" FontWeight="SemiBold" Foreground="#FFF0F2F3" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="PreviewSchemeText" Grid.Column="1" Text="尚未选择方案" HorizontalAlignment="Right" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" Foreground="#FFA1ABB2" FontSize="12" />
                        </Grid>
                        <Border x:Name="PreviewFrame" Height="220" CornerRadius="10" Background="Black" BorderBrush="#FF3A424A" BorderThickness="1">
                            <Grid>
                                <MediaPlayerElement x:Name="PreviewView" Stretch="Uniform" AreTransportControlsEnabled="False" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                                <Grid x:Name="PreviewFadeOverlay" Background="Black" Opacity="0" IsHitTestVisible="False" />
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="8,4" CornerRadius="5" Background="#B3000000">
                                    <TextBlock Text="实际输出效果预览" FontSize="10" Foreground="#FFE1F3EB" />
                                </Border>
                                <TextBlock Text="●  PREVIEW" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" FontFamily="Consolas" FontSize="10" Foreground="#FF8CD4BA" />
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Width="34" Height="34" Padding="0" CornerRadius="17" Background="#FF2B7B5E" Foreground="White" BorderThickness="0" Click="PreviewClicked" ToolTipService.ToolTip="播放/暂停" AutomationProperties.Name="播放或暂停预览">
                                <SymbolIcon x:Name="PreviewButtonIcon" Symbol="Play" />
                            </Button>
                            <Slider x:Name="PreviewProgress" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Minimum="0" Maximum="0" Foreground="#FF62B899" />
                            <TextBlock x:Name="PreviewTimeText" Grid.Column="2" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="11" Foreground="#FFA1ABB2" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE767;" FontSize="15" Foreground="#FFA1ABB2" VerticalAlignment="Center" ToolTipService.ToolTip="音量" />
                                <Slider x:Name="PreviewVolume" Width="76" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0.8" StepFrequency="0.05" Foreground="#FF62B899" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                        <Border BorderBrush="#FF343B43" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="画面播放队列" FontSize="14" FontWeight="SemiBold" Foreground="#FFF0F2F3" VerticalAlignment="Center" />
                                    <TextBlock Text="点击定位起点 · 长按拖拽排序" HorizontalAlignment="Right" FontSize="10" Foreground="#FF9AA5AD" VerticalAlignment="Center" />
                                </Grid>
                                <GridView x:Name="VisualGallery" Padding="0" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource MediaCardItemStyle}" ItemTemplateSelector="{StaticResource QueueItemTemplateSelector}" SelectionChanged="QueueSelectionChanged" ItemClick="VisualItemClicked" DragItemsStarting="MediaQueueDragStarting" DragItemsCompleted="VisualsReordered" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="图片停留（秒）" FontSize="12" Foreground="#FF9AA5AD" VerticalAlignment="Center" />
                                    <TextBox x:Name="ImageDurationBox" Width="64" MinWidth="0" MinHeight="30" Padding="8,4" Text="5" MaxLength="4" TextAlignment="Center" BeforeTextChanging="ImageDurationBeforeTextChanging" TextChanged="ImageDurationChanged" LostFocus="ImageDurationLostFocus" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#FF343B43" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="音频播放列表" FontSize="14" FontWeight="SemiBold" Foreground="#FFF0F2F3" VerticalAlignment="Center" />
                                    <TextBlock Text="点击只选中 · 按列表顺序播放" HorizontalAlignment="Right" FontSize="10" Foreground="#FF9AA5AD" VerticalAlignment="Center" />
                                </Grid>
                                <GridView x:Name="AudioGallery" Padding="0" SelectionMode="Single" CanDragItems="True" CanReorderItems="True" AllowDrop="True" ItemContainerStyle="{StaticResource MediaCardItemStyle}" ItemTemplateSelector="{StaticResource QueueItemTemplateSelector}" SelectionChanged="QueueSelectionChanged" DragItemsStarting="MediaQueueDragStarting" DragItemsCompleted="AudiosReordered" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                </GridView>
                                <TextBlock Text="不添加独立音频时使用视频原声；添加后所有视频静音。" FontSize="10" Foreground="#FF9AA5AD" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="10">
                            <CheckBox x:Name="LoopCheck" Content="循环播放" IsChecked="False" Checked="LoopChanged" Unchecked="LoopChanged" Foreground="#FFF0F2F3" VerticalAlignment="Center" />
                            <ComboBox x:Name="EndBehaviorSelector" Width="190" Header="播放结束后" HorizontalAlignment="Left" MinWidth="0" SelectionChanged="EndBehaviorChanged">
                                <ComboBoxItem Content="保持最后一帧" Tag="HoldLastFrame" />
                                <ComboBoxItem Content="最后 2 秒淡出" Tag="FadeToBlack" />
                            </ComboBox>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="SchemeCountText" Text="播放方案 · 0 套" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="拖拽 ⋮⋮ 排序" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView x:Name="SchemeList" Grid.Row="1" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True" SelectionChanged="SchemeSelectionChanged" DragItemsCompleted="SchemesReordered" DragOver="SchemeDragOver" Drop="SchemeDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Background="#08FFFFFF" Margin="0,0,0,8" AllowDrop="True" DragOver="SchemeDragOver" Drop="SchemeDrop">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="88" Height="88" CornerRadius="7" Background="#FF101318" VerticalAlignment="Top" AllowDrop="True" DragOver="SchemeDragOver" Drop="SchemeDrop">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,0,72,0" Visibility="{Binding NameVisibility}" DoubleTapped="SchemeNameDoubleTapped" />
                                                <TextBox Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditorVisibility}" MinHeight="30" Padding="6,2" Margin="0,0,72,0" LostFocus="SchemeNameEditorLostFocus" KeyDown="SchemeNameEditorKeyDown" />
                                                <TextBlock Text="⋮⋮" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,36,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Button Content="▶" Width="30" Height="30" Padding="0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="播放此方案" Click="PlaySchemeCardClicked" />
                                            </Grid>
                                            <TextBlock Text="{Binding VisualName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#66000000" CornerRadius="5" Padding="8,4" Margin="0,2,0,0">
                                                <ScrollViewer MaxHeight="54" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding AudioRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="4">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Prefix}" Foreground="#FF71809A" FontSize="10" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2" Content="×" Width="24" Height="24" Padding="0" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Visibility="{Binding DeleteVisibility}" ToolTipService.ToolTip="删除音频" Click="RemoveAudioClicked" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Content="＋ 新建播放方案" HorizontalAlignment="Stretch" Click="AddSchemeClicked" />
                    <Button Grid.Row="3" Content="删除选中方案" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="DeleteSchemeClicked" />
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="MessageBar" Grid.Row="3" Severity="Error" IsOpen="False" Margin="20,0,20,10" />

        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="12" />
                    <TextBlock Text="每套方案独立播放；上一套/下一套手动切换" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <ComboBox x:Name="PlaybackRateSelector" Grid.Column="1" MinWidth="76" SelectedIndex="0" SelectionChanged="PlaybackRateChanged" ToolTipService.ToolTip="音视频播放倍速">
                    <ComboBoxItem Content="×1" />
                    <ComboBoxItem Content="×2" />
                    <ComboBoxItem Content="×5" />
                    <ComboBoxItem Content="×10" />
                    <ComboBoxItem Content="×20" />
                </ComboBox>
                <Button Grid.Column="2" Content="开启展示" Click="OpenOutputClicked" />
                <Button Grid.Column="3" Content="结束展示" Click="EndOutputClicked" />
                <Button Grid.Column="4" Content="上一套" Click="PreviousOutputClicked" />
                <Button x:Name="PlayPauseOutputButton" Grid.Column="5" Content="▶ 开始" Style="{StaticResource AccentButtonStyle}" MinWidth="96" Click="PlayPauseOutputClicked" />
                <Button Grid.Column="6" Content="下一套" Click="NextOutputClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>

